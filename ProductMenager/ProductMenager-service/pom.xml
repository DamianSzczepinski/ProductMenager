<?xml version="1.0" encoding="UTF-8"?>
<project
		xmlns="http://maven.apache.org/POM/4.0.0"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="
        http://maven.apache.org/POM/4.0.0
        https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<!-- Odwołanie do Twojego głównego POM-a zamiast do spring-boot-starter-parent -->
	<parent>
		<groupId>com.example</groupId>
		<artifactId>ProductMenager</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>ProductMenager-service</artifactId>
	<name>ProductMenager-service</name>
	<description>Service layer module</description>
	<packaging>jar</packaging>

	<properties>
		<java.version>21</java.version>
	</properties>

	<dependencies>
		<!-- Jeśli potrzebujesz w tym module również dostępu do repozytoriów JPA (encje z -data) -->
		<dependency>
			<groupId>com.example</groupId>
			<artifactId>ProductMenager-data</artifactId>
			<version>0.0.1-SNAPSHOT</version>
		</dependency>

		<!-- Spring Web, aby można było użyć RestTemplate/WebClient do FakeStoreAPI -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- (opcjonalnie) starter JPA, jeśli jeszcze go potrzebujesz tutaj
             (ale zwykle jest w -data). Jeśli w -service też musisz korzystać
             z encji, to można tu zostawić, w innym razie usuń. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Driver do bazy MariaDB (możesz go mieć tylko w -data,
             ale jeśli tutaj też łączysz się z DB, zostaw -->
		<dependency>
			<groupId>org.mariadb.jdbc</groupId>
			<artifactId>mariadb-java-client</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Testy -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Plugin Spring Boot - zwykle deklarowany w POM rodzica,
                 ale można też tutaj (zwłaszcza jeśli chcesz "run" w tym module) -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>